{
  "name": "matrix-rain-effect",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npm run start:cpu",
    "start:cpu": "cross-env EXPO_PUBLIC_RENDERER=cpu expo start",
    "start:gpu": "cross-env EXPO_PUBLIC_RENDERER=gpu expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-gl": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  }
}
